        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;fontColor=#000000;fontSize=12;strokeColor=#70AD47;strokeWidth=2;align=center;verticalAlign=middle;" value="Integration Worker&lt;br&gt;&lt;b&gt;Java / Spring Boot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Читает outbox, выполняет retry/backoff, ограничивает нагрузку и контролирует зависшие операции." vertex="1">
          <mxGeometry height="205" width="410" x="760" y="760" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;fontColor=#000000;fontSize=12;strokeColor=#70AD47;strokeWidth=2;align=center;verticalAlign=middle;" value="ABS Adapter API&lt;br&gt;&lt;b&gt;Java / Spring Boot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Контролируемая точка интеграции. Вызывает только разрешённые PL/SQL procedures/views и не раскрывает таблицы Oracle." vertex="1">
          <mxGeometry height="245" width="430" x="1850" y="640" as="geometry" />
