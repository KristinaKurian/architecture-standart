          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="116" edge="1" parent="1" source="33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#70AD47;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" target="35" value="Логи интеграции с АБС">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="117" edge="1" parent="1" source="34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#70AD47;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" target="35" value="Метрики доставки СМС">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="300" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;fontColor=#333333;fontSize=10;strokeColor=#999999;align=left;spacing=8;verticalAlign=top;" value="&lt;b&gt;Transactional Outbox:&lt;/b&gt; заявка и задание на интеграцию записываются атомарно в PostgreSQL. Integration Worker повторяет временные ошибки, а операции с исчерпанными попытками переводит в ручной разбор. Такой вариант обеспечивает сохранность заявок и идемпотентность без внедрения нового брокера сообщений в срок MVP.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Ключевой принцип:&lt;/b&gt; только ABS Adapter API взаимодействует с внутренними интерфейсами АБС. Сайт, интернет-банк и Deposit Application API не получают прямого доступа к Oracle.&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="1740" x="710" y="1411" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;fontColor=#000000;fontSize=12;strokeColor=#70AD47;strokeWidth=2;align=center;verticalAlign=middle;" value="Observability&lt;br&gt;&lt;b&gt;логи, метрики, аудит и alerts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Correlation ID, технические и бизнес-метрики, контроль SLA и зависших заявок." vertex="1">
          <mxGeometry height="190" width="430" x="2140" y="1130" as="geometry" />
        </mxCell>
      </root>
